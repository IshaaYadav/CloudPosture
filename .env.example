# Environment Configuration for Cloud Posture Scanner
# Copy this file to .env and update with your values

# AWS Configuration
# Use AWS CLI named profile (recommended for local development)
AWS_PROFILE=cloud-posture-scanner
AWS_REGION=ap-southeast-2

# S3 Report Storage
# Replace with your actual S3 bucket name
AWS_STORAGE_TYPE=s3
POSTURE_RESULTS_BUCKET=your-existing-bucket-name

# Application Settings
APP_ENV=development
DEBUG=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# NOTE: Do NOT put AWS access keys here.
# Use AWS CLI named profiles instead:
#   aws configure --profile cloud-posture-scanner

