# ==============================================================================
# Cloud Posture Scanner - Comprehensive .gitignore
# ==============================================================================

# --- Environment & Configuration Files ---
.env
.env.*
*.env
!.env.example

# --- Python Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg

# --- Build & Distribution Directories ---
dist/
build/
frontend/dist/
frontend/build/
*.tsbuildinfo

# --- Testing & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.mypy_cache/
.ruff_cache/

# --- Node & Frontend Dependencies ---
node_modules/
frontend/node_modules/
.npm/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local Scan Reports & Export Dumps ---
reports/
scans/
scan_*.json
latest_scan.json
*.scan.json

# --- Credentials, Keys & Certificates ---
.aws/
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
aws-creds*
credentials*.json
client_secret*.json

# --- Log Files ---
*.log
logs/

# --- IDE & Editor Artifacts ---
.idea/
.vscode/
*.swp
*.swo
*~
*.code-workspace

# --- OS-Generated Files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Docker Local Mounts & Overrides ---
.docker/
docker-compose.override.yml
